{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "plugins": [
    "@typescript-eslint",
    "playwright"
  ],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:playwright/recommended"
  ],
  "rules": {
    "playwright/no-wait-for-timeout": "error",
    "playwright/no-force-option": "error",
    "playwright/no-element-handle": "error",
    "playwright/prefer-web-first-assertions": "error",
    "playwright/expect-expect": [
      "error",
      {
        "assertFunctionNames": [
          "expectCartCount",
          "expectTotal",
          "expectTranslatedTitle",
          "expectItemVisible",
          "expectEmptyCart",
          "expectItemInPreview",
          "expectSuccessMessage",
          "expectVisible",
          "expectHidden",
          "expectOpen",
          "accept",
          "decline",
          "confirm",
          "cancel"
        ]
      }
    ]
  },
  "ignorePatterns": [
    "node_modules/",
    "playwright-report/",
    "test-results/"
  ]
}
